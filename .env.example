# Create a Personal Access Token at https://airtable.com/create/tokens
# Required scopes: schema.bases:read and data.records:read
AIRTABLE_TOKEN=pat_your_token_here

# Find this in the Airtable URL/API documentation. It begins with "app".
AIRTABLE_BASE_ID=app_your_base_id_here

# Optional. Leave blank to choose a table in the web page.
AIRTABLE_DEFAULT_TABLE=

# Optional local web-server settings.
FLASK_SECRET_KEY=replace-with-a-random-local-value
PORT=5000
